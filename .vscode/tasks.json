{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "xcodebuild: Debug",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-project", "WritingBuddy.xcodeproj",
                "-scheme", "WritingBuddy",
                "-configuration", "Debug",
                "-destination", "platform=macOS",
                "CONFIGURATION_BUILD_DIR=${workspaceFolder}/build/Debug",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "xcodebuild: Clean",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-project", "WritingBuddy.xcodeproj",
                "-scheme", "WritingBuddy",
                "-configuration", "Debug",
                "clean"
            ],
            "problemMatcher": []
        }
    ]
}
